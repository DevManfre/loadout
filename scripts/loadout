#!/usr/bin/env bash
# Install, update and inspect the loadout.
#
# Loadout is a guide, not a plugin: it vendors nothing, and each entry comes
# from its own upstream. This script is the seam that drives three install
# paths — the Claude Code plugin CLI, a package manager, and a plain copy for
# loadout's own assets — without ever hiding what an entry costs in context.
#
# Usage: scripts/loadout <command> [options]
#
# Commands:
#   install            choose what to install or update, then do it
#   update             upgrade what is already installed
#   status             what is installed, at what pin, what it costs
#   doctor             dependency report; changes nothing
#   remove <entry>     uninstall one entry
#   list               the catalog as the manifest sees it
#
# Options:
#   --preset <name>    core or full (default: full)
#   --only a,b         restrict to these entries
#   --except a,b       everything but these entries
#   --scope <s>        user, project or local (default: user)
#   -y, --yes          accept every printed cost up front (required with no TTY)
#   --container a,b    carry these entries as containers, not as packages
#   --offline          never ask upstream what it publishes (no update rows)
#   -n, --dry-run      print every step and change nothing
#   -h, --help         this text
set -uo pipefail

ORIGIN_DIR=$PWD
cd "$(dirname "$0")/.."
LOADOUT_ROOT=$PWD
export LOADOUT_ROOT ORIGIN_DIR

. scripts/lib/manifest.sh
. scripts/lib/probe.sh
. scripts/lib/ui.sh
. scripts/lib/actions.sh

usage() { awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; }

SUBCOMMAND=""
OPT_YES=0
OPT_DRY_RUN=0
OPT_SCOPE=user
OPT_PRESET=full
OPT_ONLY=""
OPT_EXCEPT=""
OPT_CONTAINER=""
ARGS=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -y|--yes) OPT_YES=1; shift ;;
    -n|--dry-run) OPT_DRY_RUN=1; shift ;;
    --offline) LOADOUT_NO_NET=1; export LOADOUT_NO_NET; shift ;;
    --scope) OPT_SCOPE=${2:?--scope needs a value}; shift 2 ;;
    --scope=*) OPT_SCOPE=${1#*=}; shift ;;
    --preset) OPT_PRESET=${2:?--preset needs a value}; shift 2 ;;
    --preset=*) OPT_PRESET=${1#*=}; shift ;;
    --only) OPT_ONLY=${2:?--only needs a value}; shift 2 ;;
    --only=*) OPT_ONLY=${1#*=}; shift ;;
    --except) OPT_EXCEPT=${2:?--except needs a value}; shift 2 ;;
    --except=*) OPT_EXCEPT=${1#*=}; shift ;;
    --container) OPT_CONTAINER=${2:?--container needs a value}; shift 2 ;;
    --container=*) OPT_CONTAINER=${1#*=}; shift ;;
    # Kept so the old flags in the README and in people's history keep working.
    --skip-graphify) OPT_EXCEPT="${OPT_EXCEPT:+$OPT_EXCEPT,}graphify"
      note "--skip-graphify is deprecated; use --except graphify"; shift ;;
    --skip-headroom) OPT_EXCEPT="${OPT_EXCEPT:+$OPT_EXCEPT,}headroom"
      note "--skip-headroom is deprecated; use --except headroom"; shift ;;
    -*) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
    *)
      if [ -z "$SUBCOMMAND" ]; then SUBCOMMAND=$1; else ARGS="${ARGS:+$ARGS }$1"; fi
      shift ;;
  esac
done

case "$OPT_SCOPE" in
  user|project|local) ;;
  *) printf -- '--scope must be user, project or local (got %s)\n' "$OPT_SCOPE" >&2; exit 2 ;;
esac

cmd_doctor() {
  local name blocked=0 token
  for name in $(manifest_names); do
    say "$name"
    cost "$(manifest_field "$name" 7)"
    for token in $(entry_deps "$name" block); do
      blocked=1
      printf '   [!] %s — cannot install here (missing: %s)\n' "$name" "$token"
      explain_dep "$token" "$name"
    done
    for token in $(entry_deps "$name" warn); do
      printf '   [~] %s — installable, degraded (missing: %s)\n' "$name" "$token"
      explain_dep "$token" "$name"
    done
    [ -n "$(entry_deps "$name" block)$(entry_deps "$name" warn)" ] || note "ready"
  done
  return "$blocked"
}

cmd_list() {
  printf '%-12s %-7s %-10s %-24s %s\n' entry kind presets cost measured
  local name
  for name in $(manifest_names); do
    printf '%-12s %-7s %-10s %-24s %s\n' \
      "$name" "$(manifest_field "$name" 2)" "$(manifest_field "$name" 4)" \
      "$(manifest_field "$name" 7)" "$(manifest_field "$name" 8)"
  done
}

cmd_status() {
  printf '%-12s %-16s %-10s %-24s %s\n' entry installed measured cost note
  local name installed measured drift gap gaps
  for name in $(manifest_names); do
    if entry_installed_locally "$name"; then
      installed=$(entry_version "$name")
    elif entry_installed "$name"; then
      # A live proxy answering from a container or another host: nothing on
      # this machine to read a pin from, but "not installed" would be a lie —
      # and a proxy that names its own version in /health turns "remote" into
      # a pin somebody can compare against the catalog.
      installed=$(entry_version "$name")
      case "$installed" in -) installed="remote" ;; *) installed="remote $installed" ;; esac
    else
      installed="not installed"
    fi
    measured=$(manifest_field "$name" 8)
    drift=""
    case "$installed" in
      "not installed"|remote*|-) ;;
      "$measured") ;;
      *) drift="DRIFT" ;;
    esac
    gap=""
    if [ "$installed" != "not installed" ]; then
      # Every gap, not only the last one: an entry can be missing more than one
      # runtime dependency, and a report that names one of them is misleading.
      gaps=$(entry_deps "$name" runtime | tr '\n' ',' | sed 's/,$//')
      [ -z "$gaps" ] || gap="installed, not in the path ($gaps)"
    fi
    printf '%-12s %-16s %-10s %-24s %s\n' \
      "$name" "$installed" "$measured" "$(manifest_field "$name" 7)" "${drift}${drift:+ }${gap}"
  done
  printf '\n   projected cost of an installed plugin: claude plugin details <name>\n'
}

cmd_install() {
  local -a selection
  local name token

  # A hard stop, not a per-entry skip: without a TTY to ask on and without
  # --yes to accept the printed costs up front, there is no way to confirm a
  # single mutation, so the whole command refuses rather than silently
  # skipping its way to a quiet, successful-looking no-op.
  if [ "$OPT_YES" -ne 1 ] && [ ! -t 0 ]; then
    printf '   FAIL: no TTY to confirm on; re-run with --yes to accept the printed costs\n' >&2
    return 1
  fi

  if [ "$OPT_YES" -eq 1 ] || [ -n "$OPT_ONLY" ] || [ -n "$OPT_EXCEPT" ] || [ ! -t 0 ]; then
    mapfile -t selection < <(resolve_selection)
  else
    # mapfile's own exit status is never menu_select's — command substitution
    # runs in a subshell, so its return only reaches us through $(...) here,
    # captured before mapfile (which always "succeeds" reading empty input)
    # gets a chance to hide it.
    local selection_out
    if selection_out=$(menu_select $(resolve_selection)); then
      if [ -n "$selection_out" ]; then mapfile -t selection <<< "$selection_out"; else selection=(); fi
      # The menu just priced this exact set and the user pressed Enter on it:
      # that is consent for the set, not a license to skip every other prompt.
      SELECTION_CONFIRMED=1
    else
      note "cancelled"
      return 0
    fi
  fi

  # The menu marks its update rows: an install and an update run different
  # code, ask for different consent and are counted apart, so a bare name
  # cannot carry both and the two sets part company here, once.
  local -a updates=() installs=()
  for name in "${selection[@]:-}"; do
    [ -n "$name" ] || continue
    case "$name" in
      update:*) updates+=("${name#update:}") ;;
      *)        installs+=("$name") ;;
    esac
  done
  selection=("${installs[@]:-}")

  # An entry named explicitly but blocked must say why rather than vanish.
  if [ -n "$OPT_ONLY" ]; then
    for name in $(printf '%s' "$OPT_ONLY" | tr ',' ' '); do
      manifest_field "$name" 1 >/dev/null 2>&1 || continue
      printf '%s\n' "${selection[@]:-}" | grep -qx "$name" && continue
      entry_installed "$name" && continue
      say "$name"
      for token in $(entry_deps "$name" block); do
        printf '   [!] %s — cannot install here (missing: %s)\n' "$name" "$token"
        explain_dep "$token" "$name"
      done
    done
  fi

  # Dependencies the installer can provide itself come first, each behind its
  # own prompt; a declined or failed fix leaves its entries on the normal
  # blocked path inside install_entry, which re-probes for itself.
  for token in $(selection_fixables "${selection[@]:-}"); do
    fix_dep "$token" || :
  done

  if [ "${#selection[@]}" -gt 0 ] && [ -n "${selection[0]:-}" ]; then
    say "$(selection_total "${selection[@]}")"
    for name in "${selection[@]}"; do install_entry "$name"; done
  fi

  # Updates come after the installs: moving something already in use off its
  # pin is the heavier half of the run, and it is priced as its own block —
  # every pin on screen, then one answer for the set, because the menu already
  # showed each row as `installed → upstream` and Enter was pressed on it.
  if [ "${#updates[@]}" -gt 0 ] && [ -n "${updates[0]:-}" ]; then
    say "updates"
    for name in "${updates[@]}"; do
      printf '   %s\n' "$name"
      pin_report "$name"
    done
    if confirm "move these ${#updates[@]} off the pins above?"; then
      for name in "${updates[@]}"; do update_entry "$name"; done
    else
      note "declined; nothing was updated"
      SKIPPED=$((SKIPPED + ${#updates[@]}))
    fi
  fi

  local asset_root
  if [ "$OPT_SCOPE" = user ]; then asset_root=$HOME/.claude; else asset_root=$ORIGIN_DIR/.claude; fi
  say "loadout's own assets"
  cost "one description each in the skill or agent index; bodies load only when invoked"
  copy_own_assets "$asset_root"

  printf '\n== done: %d installed, %d updated, %d skipped, %d failed\n' \
    "$INSTALLED" "$UPDATED" "$SKIPPED" "$PROBLEMS"
  [ "$OPT_DRY_RUN" -eq 1 ] && note "(dry run — nothing was changed)"
  note "too heavy in practice? '/plugin disable <name>' drops it from context without uninstalling."
  [ "$PROBLEMS" -eq 0 ]
}

cmd_update() {
  local name asset_root

  # A hard stop, not a per-entry skip: without a TTY to ask on and without
  # --yes to accept an unmeasured pin, there is no way to confirm a single
  # mutation, so the whole command refuses rather than silently skipping its
  # way to a quiet, successful-looking no-op.
  if [ "$OPT_YES" -ne 1 ] && [ ! -t 0 ]; then
    printf '   FAIL: no TTY to confirm on; re-run with --yes to accept the printed costs\n' >&2
    return 1
  fi

  for name in $(manifest_names); do
    [ -z "$OPT_ONLY" ] || _in_list "$name" "$OPT_ONLY" || continue
    [ -z "$OPT_EXCEPT" ] || ! _in_list "$name" "$OPT_EXCEPT" || continue
    update_entry "$name"
  done
  if [ "$OPT_SCOPE" = user ]; then asset_root=$HOME/.claude; else asset_root=$ORIGIN_DIR/.claude; fi
  update_own_assets "$asset_root"
  printf '\n== done: %d updated, %d skipped, %d failed\n' "$UPDATED" "$SKIPPED" "$PROBLEMS"
  [ "$PROBLEMS" -eq 0 ]
}

cmd_remove() {
  local name=${ARGS%% *}
  [ -n "$name" ] || { printf 'remove needs an entry name\n' >&2; return 2; }
  manifest_field "$name" 1 >/dev/null 2>&1 || {
    printf 'unknown entry: %s (see: scripts/loadout list)\n' "$name" >&2; return 2; }
  remove_entry "$name"
  [ "$PROBLEMS" -eq 0 ]
}

# A malformed or missing data file must stop everything here, not degrade
# into whatever each caller does with an empty $(...): list prints only its
# header, install reports "0 installed" and exits 0 — both look like a clean,
# uneventful run of an empty catalog rather than a broken one. _table_rows
# already printed the awk parse error to stderr; this adds the one-line
# verdict that turns it into a hard failure instead of a silently swallowed
# status.
manifest_rows >/dev/null || { printf 'FAIL: %s is unreadable or malformed\n' "$LOADOUT_MANIFEST" >&2; exit 1; }
deps_rows     >/dev/null || { printf 'FAIL: %s is unreadable or malformed\n' "$LOADOUT_DEPS" >&2; exit 1; }

# --only, --except and --preset are validated the same way --scope already
# is above: a typo here (e.g. --only grapify) must not vanish into an empty
# selection that still prints a clean-looking "0 installed" and exits 0.
case "$OPT_PRESET" in
  core|full) ;;
  *) printf -- '--preset must be core or full (got %s; see: scripts/loadout list)\n' "$OPT_PRESET" >&2
     exit 2 ;;
esac

_check_known_names() {
  local flag=$1 list=$2 tok
  for tok in $(printf '%s' "$list" | tr ',' ' '); do
    manifest_field "$tok" 1 >/dev/null 2>&1 || {
      printf 'unknown entry in %s: %s (see: scripts/loadout list)\n' "$flag" "$tok" >&2
      exit 2
    }
  done
}
[ -z "$OPT_ONLY" ]   || _check_known_names --only "$OPT_ONLY"
[ -z "$OPT_EXCEPT" ] || _check_known_names --except "$OPT_EXCEPT"
# A name here must also be an entry that can actually run as a container, or
# the flag would be accepted and then quietly do nothing.
if [ -n "$OPT_CONTAINER" ]; then
  _check_known_names --container "$OPT_CONTAINER"
  for tok in $(printf '%s' "$OPT_CONTAINER" | tr ',' ' '); do
    container_field "$tok" 2 >/dev/null 2>&1 || {
      printf 'no container for %s (see: scripts/loadout.containers)\n' "$tok" >&2
      exit 2
    }
  done
fi

case "$SUBCOMMAND" in
  doctor) cmd_doctor ;;
  ""|help) usage; exit 0 ;;
  list) cmd_list ;;
  status) cmd_status ;;
  install) cmd_install ;;
  update) cmd_update ;;
  remove) cmd_remove ;;
  *) printf 'unknown command: %s\n' "$SUBCOMMAND" >&2; usage >&2; exit 2 ;;
esac
